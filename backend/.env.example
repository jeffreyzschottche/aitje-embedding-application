APP_NAME="Aitje Embedding"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

APP_LOCALE=nl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=nl_NL

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE="Aitje-ExternalEmbedding"
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@localhost.test"
MAIL_FROM_NAME="${APP_NAME}"

# Admin CMS login. Store a bcrypt hash, not the plain password.
# Generate locally with: php -r "echo password_hash('your-password', PASSWORD_BCRYPT);"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_TOKEN_TTL_MINUTES=480

# Optional: defaults for Git export configuration.
KENNISBANK_GIT_REPO=
KENNISBANK_GIT_BRANCH=main
KENNISBANK_GIT_TOKEN=
